      "required": [
        "approval_id",
        "specification_id",
        "revision",
        "content_digest",
        "actor_id",
        "decision",
        "scope",
        "issued_at",
        "expires_at",
        "policy_version"
      ],
      "title": "SpecificationApproval",
      "type": "object"

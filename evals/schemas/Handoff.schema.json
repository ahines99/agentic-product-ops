        "resolved_by": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved By"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved At"
        }
      },
      "required": [
        "id",
        "question",
        "why_it_matters",
        "affected_requirement_ids",
        "blocking",
        "resolution",
        "resolved_by",
        "resolved_at"
      ],
      "title": "UnresolvedQuestion",

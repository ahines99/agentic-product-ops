        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "SourceStatement",
      "type": "object"
    },
    "SpecificationProvenance": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "authored_fixture",
            "unrecognized_input",
            "model_proposal"

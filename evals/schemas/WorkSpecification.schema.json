{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "provenance": {
          "enum": [
            "directly_stated",
            "repository_or_policy",
            "safe_inference",
            "requires_human_decision"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "verification_kind": {
          "enum": [
            "automated_test",
            "manual_behavior",
            "telemetry",
            "security_check",
            "data_reconciliation",
            "documentation"
          ],
          "title": "Verification Kind",
          "type": "string"
        },
        "evidence_required": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Evidence Required",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "requirement_ids",
        "provenance",
        "verification_kind",
        "evidence_required",
        "blocking"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "ApprovalPolicy": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Policy Version",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Workspace Id",
          "type": "string"
        },
        "max_age_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "required_role": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Required Role",
          "type": "string"
        }
      },
      "required": [
        "policy_version",
        "workspace_id",
        "max_age_seconds",
        "required_role"
      ],
      "title": "ApprovalPolicy",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "non_behavioral": {
          "const": true,
          "title": "Non Behavioral",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "non_behavioral"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "work_item_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Work Item Id",
          "type": "string"
        },
        "depends_on": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Depends On",
          "type": "string"
        }
      },
      "required": [
        "work_item_id",
        "depends_on"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Excerpt",
          "type": "string"
        },
        "blob_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Blob Digest",
          "type": "string"
        },
        "advisory": {
          "const": true,
          "default": true,
          "title": "Advisory",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "path",
        "excerpt",
        "blob_digest"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RepositoryContext": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Repository Id",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "relevant_tests": {
          "items": {
            "maxLength": 16000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Relevant Tests",
          "type": "array"
        },
        "unknown_edges": {
          "items": {
            "maxLength": 16000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Unknown Edges",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Confidence"
        }
      },
      "required": [
        "repository_id",
        "snapshot_id",
        "snapshot_digest",
        "evidence",
        "relevant_tests",
        "unknown_edges",
        "confidence"
      ],
      "title": "RepositoryContext",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",

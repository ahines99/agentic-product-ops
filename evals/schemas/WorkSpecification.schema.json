  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "specification_id": {
      "format": "uuid",
      "title": "Specification Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "title": {
      "maxLength": 16000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "objective": {
      "maxLength": 16000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Objective",
      "type": "string"
    },
    "source_statements": {
      "items": {
        "$ref": "#/$defs/SourceStatement"
      },
      "minItems": 1,
      "title": "Source Statements",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "$ref": "#/$defs/UnresolvedQuestion"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "repository_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepositoryContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "risk": {
      "$ref": "#/$defs/RiskAssessment"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "work_items": {
      "items": {
        "$ref": "#/$defs/WorkItem"
      },
      "title": "Work Items",
      "type": "array"
    },
    "approval_policy": {

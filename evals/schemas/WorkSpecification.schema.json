        "source_kind",
        "policy_refs",
        "clarification_refs"
      ],
      "title": "SpecificationProvenance",
      "type": "object"
    },
    "UnresolvedQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "why_it_matters": {
          "maxLength": 16000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Why It Matters",
          "type": "string"
        },
        "affected_requirement_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Affected Requirement Ids",
          "type": "array"

          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Confidence"
        },
        "needs_human_decision": {
          "title": "Needs Human Decision",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "provenance",
        "source_refs",
        "confidence",
        "needs_human_decision"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RiskAssessment": {
      "additionalProperties": false,
